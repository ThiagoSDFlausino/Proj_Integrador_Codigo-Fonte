# .env.example
# Copy this file to .env and fill in your Supabase credentials
#
# Auth sem link de confirmação (só e-mail+senha):
# Dashboard → Authentication → Sign In / Providers → User Signups →
# desligar "Confirm email" → Save changes.
# Utilizadores criados ANTES disso: Authentication → Users → confirmar e-mail no menu do user
# (ou SQL no README).

REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=